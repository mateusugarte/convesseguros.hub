# ============================================================
# CONVES SYSTEM — Variáveis de Ambiente
# ============================================================
#
# COMO USAR:
#   Local:  copie este arquivo para .env.local e preencha os valores reais.
#           .env.local NUNCA deve ser commitado no git (já está no .gitignore).
#   Vercel: Settings → Environment Variables → adicionar cada chave abaixo.
#           Após adicionar, fazer novo deploy para as vars entrarem em vigor.
#
# Onde encontrar os valores no Supabase:
#   Dashboard → Settings → API
#   ├── Project URL       → VITE_SUPABASE_URL
#   ├── anon / public     → VITE_SUPABASE_ANON_KEY
#   └── service_role      → SUPABASE_SERVICE_ROLE_KEY
# ============================================================

# ── FRONTEND — obrigatórias para o app funcionar ──────────────────────────────
# Prefixo VITE_ é obrigatório para o Vite expor a variável no browser.
# Adicionar AMBAS no Vercel: Settings → Environment Variables

VITE_SUPABASE_URL=https://uqkzxtelctaaqvrihnfg.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ── BACKEND / SCRIPTS — NÃO expor no frontend ────────────────────────────────
# Necessária APENAS para:
#   - scripts/import_historico.mjs (resolver UUIDs dos orçamentistas)
#   - Supabase bypassa RLS com esta chave — nunca usar no browser
# NÃO adicionar no Vercel (não é usada pelo frontend)

SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── N8N — configurar no painel do n8n, não aqui ──────────────────────────────
# Usado pelo Claude Code para interagir com workflows do n8n
# Não é necessário para o frontend funcionar

N8N_URL=https://aula-n8n.riftvt.easypanel.host
N8N_API_KEY=sua_n8n_api_key_aqui
